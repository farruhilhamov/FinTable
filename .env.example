# Скопируйте в .env и измените значения под себя.
# Для локального запуска файл .env не обязателен — работают значения по умолчанию.

SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=*

# БД: не задавайте DATABASE_URL для SQLite (по умолчанию).
# Для PostgreSQL:
# DATABASE_URL=postgres://user:password@localhost:5432/fintable
